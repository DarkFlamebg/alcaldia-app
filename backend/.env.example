# Copia este archivo como .env y completa los valores.

APP_NAME="Alcaldía del Municipio Rafael Rangel"
# true solo en desarrollo
APP_DEBUG=true

# Clave para firmar la cookie de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# true cuando el sitio se sirva por HTTPS
SESSION_HTTPS_ONLY=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=alcaldia_db

# Tamaño máximo de imagen en MB
MAX_IMAGE_MB=5

# Solo si el frontend se sirve desde otro dominio o puerto sin proxy (separados por coma)
CORS_ORIGINS=
